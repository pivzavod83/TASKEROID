{
  "name": "taskeroid",
  "version": "1.0.0",
  "description": "Live animated wallpaper with task system - asteroids represent tasks approaching a planet",
  "main": "dist/main/index.js",
  "scripts": {
    "build": "tsc && npm run build:wallpaper && npm run build:ui",
    "build:wallpaper": "esbuild src/renderer/wallpaper-renderer.ts --bundle --outfile=dist/wallpaper-renderer.js --format=iife",
    "build:ui": "esbuild src/ui/index.tsx --bundle --outfile=dist/ui.js --format=iife --loader:.tsx=tsx --loader:.ts=ts",
    "start": "npm run build && electron .",
    "dev": "npm run build && electron .",
    "watch": "tsc -w"
  },
  "keywords": ["wallpaper", "tasks", "electron", "three.js"],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "electron": "^28.0.0",
    "esbuild": "^0.19.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "typescript": "^5.3.0"
  },
  "dependencies": {
    "sql.js": "^1.9.0",
    "three": "^0.159.0"
  }
}
